{
  "name": "creative-lab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "astro check && tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "biome lint --write --no-errors-on-unmatched",
      "prettier --write"
    ],
    "*.{astro,css,json,md,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/react": "^4.0.0",
    "ahooks": "^3.9.7",
    "astro": "^5.0.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "matter-js": "^0.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webgl-fluid": "^0.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@biomejs/biome": "^2.5.11",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@unocss/astro": "^66.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.0",
    "unocss": "^66.0.0"
  }
}
