---
import { ClientRouter } from 'astro:transitions';
import Navbar from '@/components/ui/Navbar.astro';
import Footer from '@/components/ui/Footer.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}

const {
  title = 'HANQIN — Creative Direction & Interactive Design Engineering',
  description = 'Selected works, realtime shaders, 3D typography, and interactive digital experiences.',
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        if (theme === 'light') document.documentElement.classList.remove('dark');
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>
