---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DemoCard from '@/components/ui/DemoCard.astro';
import { demos } from '@/data/demos';
---

<BaseLayout title="Demo 画廊 · HANQIN // LAB" description="A collection of interactive components and tools by Hanqin.">
  <main class="section-container pt-12 pb-24">
    <div class="mb-16 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 glass-subtle text-xs font-mono text-amber-400 mb-4">
        <span>HANQIN // EXPERIMENTAL REPOSITORY</span>
      </div>
      <h1 class="heading-section mb-4 text-white">交互原型与工具画廊</h1>
      <p class="text-text-secondary text-sm sm:text-base leading-relaxed">
        探索基于 React 19 与 Astro 5 构建的前端微交互组件、代码编辑沙盒与画布工具。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        demos.map((demo) => (
          <DemoCard
            title={demo.title}
            subtitle={demo.subtitle}
            description={demo.description}
            href={`/demos#${demo.slug}`}
            tags={demo.tags}
            icon={demo.icon}
            status={demo.status}
          />
        ))
      }
    </div>
  </main>
</BaseLayout>
