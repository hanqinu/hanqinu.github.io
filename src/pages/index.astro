---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CursorSpotlight from '@/components/landing/CursorSpotlight';
import HeroZoomSection from '@/components/landing/HeroZoomSection';
import ScrollCardFlipSection from '@/components/landing/ScrollCardFlipSection';
import ParticleWaveSection from '@/components/landing/ParticleWaveSection';
---

<BaseLayout
  title="HANQIN — Creative Direction & Interactive Design Engineering"
  description="Selected works, realtime shaders, 3D typography, and interactive digital experiences."
  hideFooter={true}
>
  <CursorSpotlight client:load />

  <main class="w-full [overflow-x:clip] bg-black">
    <!-- SCREEN 1 & 2: HANQIN Monumental Zoom & In-Place Chromatic Fluid Sheen Reveal -->
    <HeroZoomSection client:load />

    <!-- SCREEN 3: 3D Interactive Poker Card Spread & Flip (Smooth Wheel, Scroll & Click) -->
    <ScrollCardFlipSection client:load />

    <!-- SCREEN 4: Geometric Particle Ocean Wave ("Let's work together!") -->
    <ParticleWaveSection client:load />
  </main>
</BaseLayout>
