---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CursorSpotlight from '@/components/landing/CursorSpotlight';
import HeroInteractive from '@/components/landing/HeroInteractive';
import InteractiveBento from '@/components/landing/InteractiveBento';
import DemoShowcase from '@/components/landing/DemoShowcase';
import TelemetrySection from '@/components/landing/TelemetrySection';
---

<BaseLayout title="HANQIN // LAB · Creative Design Engineering" description="Personal interactive design engineering portfolio and micro-interactions laboratory by Hanqin.">
  <CursorSpotlight client:load />

  <main class="w-full overflow-hidden">
    <!-- 2D Kinetic Hero with Live Interactive Design Dock -->
    <HeroInteractive client:load />

    <!-- 5 Interactive Bento Experiments -->
    <InteractiveBento client:visible />

    <!-- Demos Gallery with In-Card Playgrounds -->
    <DemoShowcase client:visible />

    <!-- Architecture Telemetry & Kinetic Infinite Marquee -->
    <TelemetrySection client:visible />
  </main>
</BaseLayout>

