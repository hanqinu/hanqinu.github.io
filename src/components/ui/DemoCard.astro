---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  href: string;
  tags: string[];
  icon: string;
  status?: string;
}

const { title, subtitle, description, href, tags, icon, status = 'incubation' } = Astro.props;

const statusLabel =
  status === 'incubation'
    ? '● 孵化中 INCUBATING'
    : status === 'planned'
      ? '○ 规划中 PLANNED'
      : '◌ 概念待定 TBD';

const statusClass =
  status === 'incubation'
    ? 'text-amber-400 border-amber-500/30 bg-amber-500/10'
    : status === 'planned'
      ? 'text-indigo-400 border-indigo-500/30 bg-indigo-500/10'
      : 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10';
---

<div
  class="glass-panel rounded-3xl p-7 transition-all duration-300 hover:border-amber-500/50 hover:scale-[1.01] group shadow-2xl relative overflow-hidden flex flex-col justify-between"
>
  <div>
    <!-- Top Meta -->
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-white/5">
      <div class="flex items-center gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
        <span class="ml-2 font-mono text-[10px] text-white/40">{href}</span>
      </div>
      <span class={`text-[10px] font-mono px-2.5 py-0.5 rounded-full border ${statusClass}`}>
        {statusLabel}
      </span>
    </div>

    <!-- Title & Icon -->
    <div class="flex items-center gap-3.5 mb-4">
      <div
        class="w-12 h-12 rounded-2xl bg-surface-100/90 border border-white/15 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-md"
      >
        {icon}
      </div>
      <div>
        <h3 class="heading-card text-white group-hover:text-amber-400 transition-colors">
          {title}
        </h3>
        {subtitle && <span class="text-[10px] font-mono text-white/40">{subtitle}</span>}
      </div>
    </div>

    <p class="text-text-secondary text-xs sm:text-sm mb-6 leading-relaxed min-h-[38px]">
      {description}
    </p>
  </div>

  <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => <span class="mono-tag text-[10px]">{tag}</span>)}
    </div>
    <span
      class="text-xs font-mono text-amber-400 opacity-80 group-hover:translate-x-0.5 transition-transform"
    >
      待定接入 &rarr;
    </span>
  </div>
</div>
