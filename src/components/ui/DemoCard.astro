---
interface Props {
  title: string;
  description: string;
  href: string;
  tags: string[];
  icon: string;
}

const { title, description, href, tags, icon } = Astro.props;
---

<a
  href={href}
  class="block bg-[var(--color-bg-card)] border border-[var(--color-border)] rounded-xl p-6 transition-all duration-300 hover:border-[var(--color-primary)] hover:scale-[1.02] hover:glow-sm group"
>
  <div class="text-4xl mb-4 group-hover:scale-110 transition-transform origin-left">
    {icon}
  </div>
  <h3 class="heading-3 mb-2">{title}</h3>
  <p class="text-[var(--color-text-secondary)] text-sm mb-4 line-clamp-2 min-h-[40px]">
    {description}
  </p>
  <div class="flex flex-wrap gap-2 mt-auto">
    {
      tags.map((tag) => (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--color-bg-secondary)] text-[var(--color-text-secondary)] border border-[var(--color-border)]">
          {tag}
        </span>
      ))
    }
  </div>
</a>
