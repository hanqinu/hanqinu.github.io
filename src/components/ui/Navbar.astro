---
import ThemeToggle from '@/components/ui/ThemeToggle';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isDemos = currentPath.startsWith('/demos');
---

<nav class="fixed top-0 left-0 w-full z-50 glass-card h-16 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 md:px-12 h-full flex items-center justify-between">
    <a
      href="/"
      class="flex items-center gap-2.5 group"
    >
      <div class="w-8 h-8 rounded-lg bg-surface-100 border border-white/10 flex items-center justify-center font-mono font-black text-white text-xs group-hover:border-amber-500/50 group-hover:text-amber-400 transition-colors shadow-sm">
        HQ
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-black tracking-tight text-white flex items-center gap-1.5">
          HANQIN <span class="text-amber-500 font-mono font-normal text-xs">// LAB</span>
        </span>
        <span class="text-[9px] font-mono text-white/40 tracking-widest uppercase">Creative Technologist</span>
      </div>
    </a>

    <div class="flex items-center gap-6">
      <a
        href="/"
        class={`text-xs font-mono tracking-wider transition-colors hover:text-amber-400 ${isHome ? 'text-amber-400 font-bold' : 'text-white/60'}`}
      >
        [ 首页 HOME ]
      </a>
      <a
        href="/demos"
        class={`text-xs font-mono tracking-wider transition-colors hover:text-amber-400 ${isDemos ? 'text-amber-400 font-bold' : 'text-white/60'}`}
      >
        [ 实验画廊 DEMOS ]
      </a>

      <div class="w-px h-5 bg-white/10 mx-1"></div>

      <ThemeToggle client:load />
    </div>
  </div>
</nav>
