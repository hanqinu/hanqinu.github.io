---
import ThemeToggle from '@/components/ui/ThemeToggle';
---

<nav
  class="fixed top-0 left-0 w-full z-50 h-18 backdrop-blur-2xl bg-black/40 border-b border-white/10 select-none"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 h-full flex items-center justify-between">
    <!-- Brand Monogram -->
    <a href="/" class="flex items-center gap-3 group">
      <div
        class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center font-mono font-black text-white text-xs tracking-tighter group-hover:bg-white group-hover:text-black transition-all shadow-lg"
      >
        HQ
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-black tracking-tight text-white flex items-center gap-2">
          HANQIN <span
            class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-white/10 text-neutral-300 border border-white/10"
            >STUDIO</span
          >
        </span>
        <span class="text-[9px] font-mono text-white/40 tracking-widest uppercase"
          >Creative Direction & Craft</span
        >
      </div>
    </a>

    <!-- Navigation Anchors -->
    <div class="flex items-center gap-4 sm:gap-7">
      <a
        href="#chromatic-text"
        class="hidden md:inline-block text-xs font-mono tracking-wider text-white/60 hover:text-white transition-colors"
      >
        01 // CHROMATIC
      </a>
      <a
        href="#card-flip-experience"
        class="hidden md:inline-block text-xs font-mono tracking-wider text-white/60 hover:text-white transition-colors"
      >
        02 // 3D CARDS
      </a>
      <a
        href="#particle-wave-ocean"
        class="hidden md:inline-block text-xs font-mono tracking-wider text-white/60 hover:text-white transition-colors"
      >
        03 // PARTICLES
      </a>
      <a
        href="/demos"
        class="text-xs font-mono tracking-wider px-3 py-1.5 rounded-xl border border-white/15 bg-white/5 hover:bg-white/15 text-white/80 hover:text-white transition-all shadow-sm"
      >
        LAB / DEMOS &rarr;
      </a>

      <div class="w-px h-4 bg-white/15 hidden sm:block"></div>

      <ThemeToggle client:load />
    </div>
  </div>
</nav>
