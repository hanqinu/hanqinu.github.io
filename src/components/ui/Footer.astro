---
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-white/10 bg-surface-200/80 py-10 mt-auto relative z-10 backdrop-blur-md">
  <div
    class="max-w-7xl mx-auto px-6 md:px-12 flex flex-col md:flex-row items-center justify-between gap-6 font-mono text-xs text-white/50"
  >
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span class="text-white/80 font-bold">HANQIN // LAB</span>
      <span class="text-white/30">|</span>
      <span>CRAFTED WITH PRECISION & MOTION</span>
    </div>

    <div class="flex items-center gap-6">
      <div class="text-white/40">
        SYS_STATUS: <span class="text-emerald-400">NOMINAL</span>
      </div>
      <span>&copy; {year} HANQIN</span>
      <a
        href="https://github.com/hanqinu"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-amber-400 transition-colors flex items-center gap-1.5 text-white/70"
        aria-label="GitHub @hanqinu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        <span>@hanqinu</span>
      </a>
    </div>
  </div>
</footer>
